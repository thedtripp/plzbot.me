# Copy to .env in the repo root before `docker compose up`.
# The hostname that points at this VM. No domain yet? Use the free sslip.io scheme with your
# public IP, e.g. 203-0-113-7.sslip.io — Let's Encrypt will issue for it.
PLZBOT_DOMAIN=203-0-113-7.sslip.io
# Let's Encrypt expiry / problem notices go here.
ACME_EMAIL=you@example.com
# Password for the bundled Postgres that stores fingerprints. Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# To use an external Postgres (Neon, Supabase, ...) instead, set its connection string; the
# bundled postgres service is then unused. Never commit this value.
# PLZBOT_DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Days to keep stored fingerprints (0 = forever).
# PLZBOT_STORE_RETENTION_DAYS=90
# Optional: path *inside the container* to an iptoasn.com TSV for ASN lookups (see deploy/README.md).
# PLZBOT_IP2ASN_PATH=/data/ip2asn-combined.tsv
