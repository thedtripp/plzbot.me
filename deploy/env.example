# Copy to .env in the repo root before `docker compose up`.
# The hostname that points at this VM. No domain yet? Use the free sslip.io scheme with your
# public IP, e.g. 203-0-113-7.sslip.io — Let's Encrypt will issue for it.
PLZBOT_DOMAIN=203-0-113-7.sslip.io
# Let's Encrypt expiry / problem notices go here.
ACME_EMAIL=you@example.com
# Optional: path *inside the container* to an iptoasn.com TSV for ASN lookups (see deploy/README.md).
# PLZBOT_IP2ASN_PATH=/data/ip2asn-combined.tsv
# Postgres connection string where fingerprints are saved (e.g. Neon). Secret: never commit .env.
# PLZBOT_DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Password for the private analysis page at https://<host>/admin (12+ chars; generate: openssl rand -base64 18).
# Unset = the page does not exist. Secret: never commit .env.
# PLZBOT_ADMIN_PASSWORD=
# Max fingerprints saved per visitor per minute / hour / day (defaults shown) and a table-size cap in MB.
# PLZBOT_STORE_LIMIT_PER_MINUTE=10
# PLZBOT_STORE_LIMIT_PER_HOUR=30
# PLZBOT_STORE_LIMIT_PER_DAY=100
# PLZBOT_STORE_MAX_TABLE_MB=800
# Optional Google reCAPTCHA Enterprise score on /behavior (see deploy/README.md). All three = on; none = off. The API key is a secret.
# PLZBOT_RECAPTCHA_PROJECT_ID=
# PLZBOT_RECAPTCHA_SITE_KEY=
# PLZBOT_RECAPTCHA_API_KEY=
# Stop asking Google after this many assessments per month (UTC). Google's free allowance is 10,000. 0 = no cap.
# PLZBOT_RECAPTCHA_MONTHLY_CAP=8000
