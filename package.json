{
  "name": "plzbot.me",
  "version": "0.1.0",
  "private": true,
  "description": "Educational client fingerprinting engine (server + browser signal collection, evidence-based interpretation).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node --import tsx src/server/index.ts",
    "build:client": "node scripts/build-client.mjs",
    "certs": "node scripts/gen-dev-certs.mjs",
    "pretest": "node scripts/build-client.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
