{
  "name": "plzbot.me",
  "version": "0.1.0",
  "private": true,
  "description": "Educational client fingerprinting engine (server + browser signal collection, evidence-based interpretation).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:http": "PLZBOT_MODE=http PLZBOT_TRUST_PROXY=0 tsx watch src/server/index.ts",
    "start": "node dist/src/server/index.js",
    "start:src": "node --import tsx src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "node scripts/build-client.mjs",
    "build:server": "tsc -p tsconfig.build.json",
    "certs": "node scripts/gen-dev-certs.mjs",
    "probe": "node scripts/probe.mjs",
    "pretest": "node scripts/build-client.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.24.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
